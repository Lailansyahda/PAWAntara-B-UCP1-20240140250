<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="dashboard-header">
      <h1>Dashboard Admin</h1>
      <p>Masuk sebagai: <strong><%= adminUsername %></strong></p>
    </section>

    <section class="dashboard-form-section" aria-labelledby="form-heading">
      <h2 id="form-heading">Tambah / Edit Produk</h2>
      <p id="dashboardMessage" class="form-error" role="alert" aria-live="assertive"></p>

      <form id="productForm" class="filter-form" aria-label="Form tambah atau edit produk">
        <input type="hidden" id="productId" value="" />

        <div class="form-group">
          <label for="name">Nama Produk</label>
          <input type="text" id="name" name="name" required />
        </div>

        <div class="form-group">
          <label for="category">Kategori</label>
          <input type="text" id="category" name="category" required />
        </div>

        <div class="form-group">
          <label for="price">Harga (Rp)</label>
          <input type="number" id="price" name="price" min="0" required />
        </div>

        <div class="form-group">
          <label for="stock">Stok</label>
          <input type="number" id="stock" name="stock" min="0" required />
        </div>

        <div class="form-group" style="min-width: 260px;">
          <label for="image">URL Gambar Produk</label>
          <input type="url" id="image" name="image" placeholder="https://contoh.com/gambar.jpg" />
          <p class="image-hint">Kosongkan untuk pakai ikon otomatis sesuai kategori.</p>
          <button type="button" class="btn-secondary" id="clearImageBtn">Hapus Gambar</button>
        </div>

        <div class="form-group">
          <label for="description">Deskripsi</label>
          <textarea id="description" name="description" rows="2"></textarea>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">Tambah Produk</button>
        <button type="button" class="btn-secondary" id="cancelEditBtn" hidden>Batal Edit</button>
      </form>
    </section>

    <section class="dashboard-list-section" aria-label="Daftar produk admin">
      <h2>Daftar Produk</h2>
      <div id="adminProductList" class="product-grid" aria-live="polite">
        <p>Memuat data produk...</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>