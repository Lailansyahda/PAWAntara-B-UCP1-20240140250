<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="produk-header">
      <h1>Daftar Produk</h1>

      <form id="filterForm" class="filter-form" aria-label="Filter produk">
        <div class="form-group">
          <label for="search">Cari produk</label>
          <input type="text" id="search" name="search" placeholder="cth: beras" />
        </div>

        <div class="form-group">
          <label for="kategori">Kategori</label>
          <select id="kategori" name="kategori">
            <option value="">Semua kategori</option>
          </select>
        </div>

        <button type="submit" class="btn-primary">Terapkan Filter</button>
      </form>
    </section>

    <section class="product-list" aria-label="Hasil produk">
      <div id="productContainer" class="product-grid" aria-live="polite">
        <p>Memuat produk...</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/produk.js"></script>
</body>
</html>