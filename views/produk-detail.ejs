<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <% if (!product) { %>
      <section class="not-found" aria-live="polite">
        <h1>Produk Tidak Ditemukan</h1>
        <p>Maaf, produk dengan ID tersebut tidak ada di toko kami.</p>
        <a href="/produk" class="btn-primary">Kembali ke Daftar Produk</a>
      </section>
    <% } else {
      const icons = { sembako: "🌾", protein: "🥚", bumbu: "🧂", instan: "🍜" };
      const icon = icons[product.category] || "🛒";
    %>
      <article class="product-detail">
        <div class="product-media" style="height: 220px;">
          <% if (product.image) { %>
            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              class="product-image"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="product-icon" aria-hidden="true" style="display:none;"><%= icon %></div>
          <% } else { %>
            <div class="product-icon" aria-hidden="true"><%= icon %></div>
          <% } %>
        </div>
        <h1><%= product.name %></h1>
        <p class="product-category">Kategori: <%= product.category %></p>
        <p class="product-price">Harga: Rp<%= product.price.toLocaleString('id-ID') %></p>
        <p class="product-stock">Stok tersedia: <%= product.stock %></p>
        <p class="product-description"><%= product.description %></p>
        <a href="/produk" class="btn-secondary">&larr; Kembali ke Daftar Produk</a>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>